# Structverify Platform — 환경변수 예시
# 실제 사용 시 이 파일을 `.env`로 복사하고 값을 채우세요.
# .env는 절대 git에 commit하지 마세요.

# ── 앱 환경 ─────────────────────────────────────────
APP_ENV=dev
DEBUG=true

# ── PostgreSQL ──────────────────────────────────────
# (라이브러리 측 KOSIS catalog가 이미 쓰는 DB를 그대로 써도 됨)
POSTGRES_DSN=postgresql+asyncpg://

# ── Redis (Phase 2 — ARQ 잡 큐) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM (HCX) ────────────────────────────────────────
# Pydantic 중첩 필드: `LLM__필드명` 형태로 override
LLM__API_KEY=nv-
# LLM__PRIMARY_MODEL=HCX-007         # default 사용 시 생략
# LLM__FALLBACK_MODEL=HCX-DASH-002

# ── KOSIS Open API ──────────────────────────────────
KOSIS_API_KEY="="
NCP_API_KEY="nv-"
# ── 인증/보안 (반드시 production에서 random하게 교체) ──
AUTH__JWT_SECRET=replace-with-long-random-string
AUTH__API_KEY_PEPPER=replace-with-another-long-random-string

# ── 파일 저장소 (PDF/DOCX 업로드) ────────────────────
STORAGE__TYPE=local
STORAGE__LOCAL_PATH=./uploads
# STORAGE__TYPE=s3
# STORAGE__S3_BUCKET=structverify-uploads
# STORAGE__S3_REGION=ap-northeast-2

# ── CORS (Frontend가 다른 origin일 때 허용 목록) ────
# 쉼표 구분 — Pydantic이 list로 파싱
# CORS_ORIGINS=["http://localhost:3000","https://app.structverify.com"]
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=structverify
POSTGRES_USER=structverify
POSTGRES_PASSWORD=svpass123
KOSIS_CATALOG_JSON="/Users/gim-yeseul/Downloads/Desktop/kosis_catalog_cache.json"
PGVECTOR_DSN=postgresql://structverify:svpass123@localhost:5432/structverify